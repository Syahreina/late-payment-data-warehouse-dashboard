    <worksheet name='AR Bucket Distribution'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#898989' fontname='Benton Sans Book' fontsize='12'>AR Bucket Distribution</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='dm_latecalculation (gold.dm_latecalculation) (postgres)' name='federated.0sog94m1svrsvj10tr96c0hu3g4f' />
          </datasources>
          <datasource-dependencies datasource='federated.0sog94m1svrsvj10tr96c0hu3g4f'>
            <column caption='AR Bucket Sort' datatype='integer' name='[Calculation_1132517278658571]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [ar_bucket]&#13;&#10;WHEN &quot;current&quot; THEN 0&#13;&#10;WHEN &quot;01. 1 - 30 DPD&quot; THEN 1&#13;&#10;WHEN &quot;02. 31 - 60 DPD&quot; THEN 2&#13;&#10;WHEN &quot;03. 61 - 90 DPD&quot; THEN 3&#13;&#10;WHEN &quot;04. &gt; 90 DPD (NPL)&quot; THEN 4&#13;&#10;ELSE 99&#13;&#10;END' />
            </column>
            <column aggregation='Sum' caption='Agreement Id' datatype='integer' name='[agreement_id]' role='dimension' type='ordinal' />
            <column caption='AR Bucket' datatype='string' name='[ar_bucket]' role='dimension' type='nominal' />
            <column caption='Branch Name' datatype='string' name='[branch_name]' role='dimension' type='nominal' />
            <column-instance column='[agreement_id]' derivation='CountD' name='[ctd:agreement_id:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_1132517278658571]' derivation='Min' name='[min:Calculation_1132517278658571:qk]' pivot='key' type='quantitative' />
            <column-instance column='[ar_bucket]' derivation='None' name='[none:ar_bucket:nk]' pivot='key' type='nominal' />
            <column-instance column='[branch_name]' derivation='None' name='[none:branch_name:nk]' pivot='key' type='nominal' />
            <column-instance column='[product_type]' derivation='None' name='[none:product_type:nk]' pivot='key' type='nominal' />
            <column caption='Product_Type' datatype='string' name='[product_type]' role='dimension' type='nominal' />
          </datasource-dependencies>
          <computed-sort column='[federated.0sog94m1svrsvj10tr96c0hu3g4f].[none:ar_bucket:nk]' direction='ASC' using='[federated.0sog94m1svrsvj10tr96c0hu3g4f].[min:Calculation_1132517278658571:qk]' />
          <slices>
