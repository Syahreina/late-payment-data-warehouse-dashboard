      <aliases enabled='yes' />
      <column caption='Total Agreements' datatype='integer' name='[Calculation_1132517226631168]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([agreement_id])' />
      </column>
      <column caption='Current Agreements' datatype='integer' name='[Calculation_1132517269131265]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF ZN([days_past_due]) = 0 THEN [agreement_id] END)' />
      </column>
      <column caption='Overdue Agreements' datatype='integer' name='[Calculation_1132517277720578]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF ZN([days_past_due]) &gt; 0 THEN [agreement_id] END)' />
      </column>
      <column caption='Overdue Rate' datatype='real' default-format='p0.00%' name='[Calculation_1132517277818883]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1132517277720578] / [Calculation_1132517226631168]' />
      </column>
      <column caption='Total Overdue Amount' datatype='real' name='[Calculation_1132517277958148]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_overdue_amt])' />
      </column>
      <column caption='Total Penalty Amount' datatype='real' name='[Calculation_1132517278015493]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_penalty_amt])' />
      </column>
      <column caption='Average DPD' datatype='real' name='[Calculation_1132517278097414]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG(IF ZN([days_past_due]) &gt; 0 THEN [days_past_due] END)' />
      </column>
      <column caption='Maximum DPD' datatype='integer' name='[Calculation_1132517278187527]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MAX([days_past_due])' />
      </column>
      <column caption='Total Overdue Installments' datatype='integer' name='[Calculation_1132517278261256]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([overdue_installment_count])' />
      </column>
      <column caption='Payment Status' datatype='string' name='[Calculation_1132517278437385]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ZN([days_past_due]) &gt; 0 THEN &quot;Overdue&quot; ELSE &quot;Current&quot; END' />
      </column>
      <column caption='Collection Priority' datatype='string' name='[Calculation_1132517278527498]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ZN([days_past_due]) &gt; 90 THEN &quot;Very High Priority&quot;&#13;&#10;ELSEIF ZN([days_past_due]) &gt;= 61 THEN &quot;High Priority&quot;&#13;&#10;ELSEIF ZN([days_past_due]) &gt;= 31 THEN &quot;Medium Priority&quot;&#13;&#10;ELSEIF ZN([days_past_due]) &gt;= 1 THEN &quot;Early Priority&quot;&#13;&#10;ELSE &quot;Current&quot;&#13;&#10;END' />
      </column>
      <column caption='AR Bucket Sort' datatype='integer' name='[Calculation_1132517278658571]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [ar_bucket]&#13;&#10;WHEN &quot;current&quot; THEN 0&#13;&#10;WHEN &quot;01. 1 - 30 DPD&quot; THEN 1&#13;&#10;WHEN &quot;02. 31 - 60 DPD&quot; THEN 2&#13;&#10;WHEN &quot;03. 61 - 90 DPD&quot; THEN 3&#13;&#10;WHEN &quot;04. &gt; 90 DPD (NPL)&quot; THEN 4&#13;&#10;ELSE 99&#13;&#10;END' />
      </column>
      <column caption='Blank' datatype='string' name='[Calculation_1132517322350604]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;&quot;' />
      </column>
      <column caption='dm_latecalculation' datatype='table' name='[__tableau_internal_object_id__].[dm_latecalculation (gold.dm_latecalculation)_6FD19F9F303440AC8E151121A21E89CC]' role='measure' type='quantitative' />
